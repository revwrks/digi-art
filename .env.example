# Digi-Art Environment Configuration
# Salin file ini menjadi `.env` dan sesuaikan nilai sesuai lingkungan Anda.

APP_ENV=local
APP_DEBUG=1

DB_HOST=127.0.0.1
DB_NAME=digi_art
DB_USER=root
DB_PASS=
DB_PORT=3306

# Opsional: Google Custom Search API untuk fitur Referensi Gambar
GOOGLE_API_KEY=
GOOGLE_SEARCH_CX=
